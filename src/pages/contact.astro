---
import Base from '../layouts/Base.astro';
// HubSpot 'Ask us anything' form, same portal + form as the current thecommon.io site.
const HUBSPOT_PORTAL = '4007228';
const HUBSPOT_FORM = '845c5505-46d2-4244-a0d2-ef7fb8345de9';
---
<Base current="contact" title="Contact — The Common Squamish" description="Come say hi. The Common is at 38016 Cleveland Avenue, downtown Squamish. Email welcome@thecommon.io or send us a note.">
  <header class="page-hd">
    <div class="mesh" aria-hidden="true"></div>
    <div class="wrap">
      <span class="eyebrow on-dark">Contact</span>
      <h1>Come say <em class="shimmer">hi</em>.</h1>
      <p>Questions about membership, the venue, or just want to look around? Send a note, or drop by — we're right on Cleveland Avenue.</p>
    </div>
  </header>

  <section class="section light">
    <div class="wrap contact-grid">
      <!-- details -->
      <div class="reveal">
        <span class="eyebrow">Where to find us</span>
        <h2 class="serif" style="font-size:clamp(1.8rem,4vw,2.6rem);margin:1rem 0 1.4rem;">Downtown Squamish.</h2>
        <p class="c-row">📍 <span>38016 Cleveland Avenue,<br>Squamish, BC V8B 0A1</span></p>
        <p class="c-row">✉️ <a href="mailto:welcome@thecommon.io">welcome@thecommon.io</a></p>
        <p class="c-row">📞 <a href="tel:+17789060405">(778) 906-0405</a></p>
        <img class="photo reveal" src="/img/common/photo-6.jpg" alt="The Common storefront on Cleveland Avenue" loading="lazy" style="margin-top:1.8rem;" />
        <div class="socials">
          <a href="https://www.instagram.com/thecommon.io/" target="_blank" rel="noopener noreferrer">Instagram</a>
          <a href="https://www.facebook.com/thecommon.io/" target="_blank" rel="noopener noreferrer">Facebook</a>
          <a href="https://maps.google.com/?q=38016+Cleveland+Avenue,+Squamish,+BC" target="_blank" rel="noopener noreferrer">Directions</a>
        </div>
      </div>

      <!-- form -->
      <div class="form-card reveal">
        <h3 class="serif">Ask us anything.</h3>
        <div class="hbspt-form" id="hubspot-contact-form"></div>
        <p class="form-note">Prefer email? <a href="mailto:welcome@thecommon.io">welcome@thecommon.io</a></p>
        <script is:inline src="https://js.hsforms.net/forms/embed/v2.js"></script>
        <script is:inline define:vars={{ HUBSPOT_PORTAL, HUBSPOT_FORM }}>
          window.hsFormsOnReady = window.hsFormsOnReady || [];
          window.hsFormsOnReady.push(() => {
            hbspt.forms.create({ portalId: HUBSPOT_PORTAL, formId: HUBSPOT_FORM, target: '#hubspot-contact-form' });
          });
        </script>
      </div>
    </div>
  </section>
</Base>

<style>
  .contact-grid { display: grid; grid-template-columns: 1fr 1.1fr; gap: 3.5rem; align-items: start; }
  @media (max-width: 820px) { .contact-grid { grid-template-columns: 1fr; } }
  .c-row { display: flex; gap: 0.7rem; font-size: 1.05rem; color: var(--stone); margin-bottom: 0.9rem; align-items: flex-start; }
  .c-row a { text-decoration: underline; text-underline-offset: 3px; }
  .socials { display: flex; gap: 1.4rem; margin-top: 1.6rem; }
  .socials a { font-size: 0.78rem; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent); }
  .socials a:hover { color: var(--gold); }

  .form-card { background: var(--white); border: 1px solid var(--line); border-radius: 20px; padding: 2.2rem; box-shadow: 0 18px 44px -28px rgba(28,25,23,0.4); }
  .form-card h3 { font-size: 1.5rem; margin-bottom: 1.4rem; }
  form label { display: block; font-size: 0.82rem; font-weight: 500; color: var(--stone); margin-bottom: 1rem; }
  form input, form textarea { width: 100%; margin-top: 0.4rem; padding: 0.8rem 0.9rem; border: 1px solid var(--line); border-radius: 10px; font-family: var(--sans); font-size: 0.95rem; font-weight: 300; color: var(--ink); background: var(--paper); transition: border-color 0.2s; }
  form input:focus, form textarea:focus { outline: none; border-color: var(--gold); }
  .f-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  fieldset { border: 0; padding: 0; margin: 0 0 1rem; }
  legend { font-size: 0.82rem; font-weight: 500; color: var(--stone); margin-bottom: 0.5rem; }
  .checks { display: grid; grid-template-columns: 1fr 1fr; gap: 0.4rem 1rem; }
  .chk { display: flex; align-items: center; gap: 0.5rem; font-weight: 300; font-size: 0.9rem; color: var(--stone); margin: 0; }
  .chk input { width: auto; margin: 0; }
  .form-note { font-size: 0.85rem; color: var(--stone-soft); margin-top: 1rem; text-align: center; }
  .form-note a { color: var(--gold); text-decoration: underline; text-underline-offset: 3px; }
</style>
