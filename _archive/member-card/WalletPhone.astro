<style>
  .wp-vis { display: flex; justify-content: center; }
  .phone-w { width: 360px; max-width: 100%; flex-shrink: 0; }
  @media (min-width: 1024px) { .phone-w { width: 392px; } }
  .phone { position: relative; width: 100%; background: linear-gradient(152deg,#3c3c40,#101012 44%,#050506); border-radius: 52px; padding: 11px; box-shadow: inset 0 1.5px 1px rgba(255,255,255,.24), inset 0 0 0 1px rgba(0,0,0,.5), 0 50px 90px -28px rgba(0,0,0,.55), 0 20px 46px -16px rgba(0,0,0,.4); }
  .phone::before { content: ''; position: absolute; left: -2px; top: 20%; width: 3px; height: 30px; border-radius: 2px; background: #15151a; box-shadow: 0 44px 0 #15151a; }
  .phone::after { content: ''; position: absolute; right: -2px; top: 28%; width: 3px; height: 58px; border-radius: 2px; background: #15151a; }
  .phone-sc { position: relative; background: #ececef; border-radius: 43px; overflow: hidden; aspect-ratio: 9 / 19.5; }
  .phone-sc::after { content: ''; position: absolute; inset: 0; z-index: 6; pointer-events: none; background: linear-gradient(140deg, rgba(255,255,255,.14), transparent 28%); }
  .dyn-island { position: absolute; top: 13px; left: 50%; transform: translateX(-50%); width: 90px; height: 28px; background: #000; border-radius: 15px; z-index: 7; }
  .dyn-island::after { content: ''; position: absolute; right: 11px; top: 50%; transform: translateY(-50%); width: 8px; height: 8px; border-radius: 50%; background: #0a0a14; box-shadow: inset 0 0 0 1.5px rgba(90,100,130,.45); }
  .phone-in { position: relative; height: 100%; padding: 14px 11px 30px; display: flex; flex-direction: column; }
  .phone-in::after { content: ''; position: absolute; left: 50%; bottom: 9px; transform: translateX(-50%); width: 36%; height: 5px; border-radius: 3px; background: #1c1c1e; opacity: .8; }
  .ph-st { display: flex; justify-content: space-between; align-items: center; padding: 3px 11px 0; }
  .ph-time { color: #0c0a09; font-size: 14px; font-weight: 600; letter-spacing: .02em; }
  .ph-icons { display: flex; gap: 5px; align-items: center; }
  .pass { margin-top: 20px; background: #fff; border-radius: 20px; overflow: hidden; box-shadow: 0 16px 36px rgba(0,0,0,.18), 0 1px 3px rgba(0,0,0,.1); }
  .pass-hd { display: flex; align-items: center; gap: 11px; padding: 14px 17px; background: #fff; border-bottom: 1px solid var(--line); }
  .pass-hd-mark { width: 33px; height: 33px; border-radius: 50%; background: #f3f1ee; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .pass-hd-mark .lm-img { width: 18px; height: 18px; object-fit: contain; filter: invert(1); }
  .pass-hd-name { font-size: 15px; font-weight: 500; color: var(--ink); }
  .pass-body { padding: 19px 17px; background: #fff; }
  .pass-title { font-size: 23px; font-weight: 600; line-height: 1.12; color: var(--ink); letter-spacing: -.01em; margin-bottom: 19px; }
  .pass-row { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; margin-bottom: 16px; }
  .pass-fld-l { font-size: 10px; font-weight: 500; letter-spacing: .02em; color: var(--stone-soft); margin-bottom: 3px; }
  .pass-fld-v { font-size: 15px; font-weight: 600; color: var(--ink); }
  .pass-fld.r { text-align: right; }
  .pass-div { height: 1px; background: var(--line); margin: 2px 0 17px; }
  .pass-qr-wrap { display: flex; flex-direction: column; align-items: center; margin-top: 6px; }
  .pass-qr { padding: 8px; border-radius: 18px; background: linear-gradient(135deg,#FBBF77,#F9A8D4 22%,#C4B5FD 48%,#93C5FD 68%,#86EFAC 100%); }
  .pass-qr-inner { background: #fff; border-radius: 12px; padding: 12px; line-height: 0; }
  .pass-id { text-align: center; font-size: 12px; font-weight: 400; color: var(--stone-soft); letter-spacing: .02em; margin-top: 13px; }
</style>
