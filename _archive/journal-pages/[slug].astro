---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.filter((p) => !p.data.draft).map((p) => ({ params: { slug: p.id }, props: { post: p } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const fmt = (d) => d.toLocaleDateString('en-CA', { month: 'long', day: 'numeric', year: 'numeric' });
---
<Base current="journal" title={`${post.data.title} — The Common`} description={post.data.summary}>
  <article class="post">
    <header class="post-hero">
      <div class="wrap">
        <a class="back" href="/journal/">← Journal</a>
        <span class="post-meta">{fmt(post.data.date)} · {post.data.author}</span>
        <h1>{post.data.title}</h1>
        <p class="post-lede">{post.data.summary}</p>
      </div>
    </header>
    {post.data.image && (
      <div class="wrap"><img class="post-img" src={post.data.image} alt={post.data.title} /></div>
    )}
    <div class="wrap prose">
      <Content />
    </div>
    <div class="wrap post-foot">
      <a href="/journal/" class="btn btn-outline">← More from the Journal</a>
      <a href="/events/" class="btn btn-ink">See what's on →</a>
    </div>
  </article>
</Base>

<style>
  .post-hero { padding: 130px 0 1.5rem; background: var(--paper); }
  .post-hero .wrap { max-width: 760px; }
  .back { font-size: 0.8rem; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent); }
  .post-meta { display: block; margin: 1.4rem 0 0.6rem; font-size: 0.78rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--stone-soft); }
  .post-hero h1 { font-size: clamp(2.1rem, 5vw, 3.4rem); line-height: 1.08; margin-bottom: 0.9rem; }
  .post-lede { font-size: 1.2rem; font-weight: 300; color: var(--stone); line-height: 1.6; }
  .post-img { max-width: 760px; margin: 1.5rem auto 0; width: 100%; aspect-ratio: 16/9; object-fit: cover; border-radius: 18px; box-shadow: 0 24px 50px -28px rgba(28,25,23,0.5); }
  .prose { max-width: 720px; padding-top: 2.5rem; padding-bottom: 2.5rem; }
  .prose :global(p) { font-size: 1.08rem; font-weight: 300; line-height: 1.8; color: var(--stone); margin-bottom: 1.4rem; }
  .prose :global(h3) { font-family: var(--serif); font-size: 1.5rem; color: var(--ink); margin: 2.2rem 0 0.8rem; }
  .prose :global(a) { color: var(--gold); text-decoration: underline; text-underline-offset: 3px; }
  .prose :global(ul), .prose :global(ol) { margin: 0 0 1.4rem 1.2rem; color: var(--stone); font-weight: 300; }
  .post-foot { max-width: 760px; display: flex; gap: 1rem; justify-content: space-between; flex-wrap: wrap; padding-bottom: 5rem; border-top: 1px solid var(--line); padding-top: 2rem; }
</style>
